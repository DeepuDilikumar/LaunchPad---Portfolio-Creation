# Copy to .env.local and fill in. Never commit real values.
# Every service is optional: anything left blank runs in clearly labelled demo mode.

# Public site URL (metadata, OG images, links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Force demo mode (local JSON database, demo sign-in, test payments). Useful for previews.
# LAUNCHPAD_DEMO_MODE=1

# --- Supabase: Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: use the anon key instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI refinement, diagnostic judgements, mentor, rewrites, pitches) ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=

# --- Razorpay (Dashboard → Settings → API keys / Webhooks) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- GitHub OAuth App (Settings → Developer settings → OAuth Apps) ---
# Callback URL: <site>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32-byte key for encrypting stored tokens: `openssl rand -base64 32`
GITHUB_TOKEN_ENC_KEY=

# --- Reminder emails (Resend) + Vercel Cron ---
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Vercel sends this as a Bearer token to /api/cron/reminders: `openssl rand -hex 32`
CRON_SECRET=

# --- Meta Pixel (numbers only) ---
NEXT_PUBLIC_META_PIXEL_ID=

# 21st.dev component tooling (Claude Code only; not used by the app at runtime)
# API_KEY_21ST=
