# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata, OG images and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects: use the anon key instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 21st.dev component tooling (Claude Code only; not used by the app at runtime)
# API_KEY_21ST=
