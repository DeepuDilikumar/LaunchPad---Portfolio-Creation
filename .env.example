# Copy to .env.local. Everything is optional for local development: with no keys, the app runs in
# mock mode (seeded users, mock payments, console email, canned tutor, embedded Postgres).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string. Signs mock sessions, unsubscribe links and the mock payment secret. Required in production.
AUTH_SECRET=

# Supabase: auth (GitHub, Google, magic link) + Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase → Project settings → Database). Unset = embedded PGlite in .data/pglite
DATABASE_URL=

# Razorpay (INR + international cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anthropic: tutor + case study generator
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Resend email
RESEND_API_KEY=
EMAIL_FROM="Buildproof <hello@your-domain.com>"

# Upstash Redis (rate limits). Unset = in-memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

GITHUB_TOKEN=                # optional, raises API limits for verification

# PostHog (loaded only after cookie consent)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

SENTRY_DSN=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Force every provider into mock mode (never in production)
MOCK_MODE=false
# Production guard: set APP_ENV=production outside Vercel so mock providers refuse to start
APP_ENV=
# Local only: pretend requests come from this country (IN shows INR prices)
DEV_COUNTRY=
