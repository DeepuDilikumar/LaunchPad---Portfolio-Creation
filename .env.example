# Copy to .env.local. Without these, `pnpm dev` still runs: in-memory DB, local file storage,
# emails written to .data/outbox, and a simulated checkout.

NEXT_PUBLIC_SITE_URL=https://secondquestion.in
# Signs unsubscribe, review and login links. Generate: openssl rand -hex 32
APP_SECRET=

# Show unreviewed drafts on the site (with a banner). Never in production.
NEXT_PUBLIC_CONTENT_PREVIEW=0

# Razorpay (test keys first: rzp_test_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase (run supabase/migrations/0001_init.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, private bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="secondquestion <hello@secondquestion.in>"
# Where delivery failures and alerts go
OWNER_EMAIL=

# Vercel cron calls /api/cron with this as a bearer token
CRON_SECRET=

# Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Set while testing the Conversions API in Events Manager
META_TEST_EVENT_CODE=

# Errors
SENTRY_DSN=

# Phase 6: AI follow-up drill
NEXT_PUBLIC_FEATURE_DRILL=0
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5; claude-haiku-5-5 is far cheaper if quality holds in your tests.
DRILL_MODEL=claude-opus-5-5
