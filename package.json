{
  "name": "secondquestion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:validate": "tsx --tsconfig tsconfig.scripts.json scripts/validate-content.ts",
    "content:stats": "tsx --tsconfig tsconfig.scripts.json scripts/build-stats.ts",
    "content:spell": "cspell --no-progress \"content/**/*.md\" \"content/**/*.json\"",
    "content:links": "tsx --tsconfig tsconfig.scripts.json scripts/check-links.ts",
    "build:pdf": "tsx --tsconfig tsconfig.scripts.json scripts/build-pdf.tsx",
    "build:previews": "tsx --tsconfig tsconfig.scripts.json scripts/build-previews.tsx",
    "stamp": "tsx --tsconfig tsconfig.scripts.json scripts/stamp.ts",
    "capture-reference": "tsx --tsconfig tsconfig.scripts.json scripts/capture-reference.ts",
    "report:weekly": "tsx --tsconfig tsconfig.scripts.json scripts/weekly-report.ts",
    "ad-spend": "tsx --tsconfig tsconfig.scripts.json scripts/ad-spend.ts",
    "reviews": "tsx --tsconfig tsconfig.scripts.json scripts/reviews.ts",
    "release": "tsx --tsconfig tsconfig.scripts.json scripts/release.ts",
    "preflight": "tsx --tsconfig tsconfig.scripts.json scripts/preflight.ts",
    "screenshots": "tsx --tsconfig tsconfig.scripts.json scripts/capture-journeys.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@sentry/nextjs": "^9.47.2",
    "@supabase/supabase-js": "2.117.3",
    "gray-matter": "4.0.3",
    "marked": "^15.0.12",
    "next": "15.5.27",
    "pdf-lib": "1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^4.8.0",
    "yaml": "2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cspell": "^9.8.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@sentry/cli"
    ]
  }
}
