  "concepts": {
    "dns": {
      "aws": {
        "service": "Route 53",
        "use_when": "Managed DNS with health-checked routing",
        "docUrl": "https://aws.amazon.com/route53/",
        "status": "active"
      },
      "gcp": {
        "service": "Cloud DNS",
        "use_when": "Managed public and private zones",
        "docUrl": "https://cloud.google.com/dns",
        "status": "active"
      },
      "azure": {
        "service": "Azure DNS",
        "use_when": "Host zones next to your Azure resources",
        "docUrl": "https://azure.microsoft.com/en-us/products/dns",
        "status": "active"
      },
      "gotcha": "DNS failover is only as fast as the TTL clients respect."
    },
    "cdn": {
      "aws": {
        "service": "CloudFront",
        "use_when": "Global edge caching for static and dynamic content",
        "docUrl": "https://aws.amazon.com/cloudfront/",
        "status": "active"
      },
      "gcp": {
        "service": "Cloud CDN",
        "use_when": "Caching on Google's edge in front of a load balancer",
        "docUrl": "https://cloud.google.com/cdn",
        "status": "active"
      },
      "azure": {
        "service": "Azure Front Door",
        "use_when": "Edge caching plus global L7 routing",
        "docUrl": "https://azure.microsoft.com/en-us/products/frontdoor",
        "status": "active"
      },
      "gotcha": "Azure CDN (classic) and Front Door (classic) are retiring; new builds use Front Door Standard/Premium."
    },
